# 최초 수집 시 가져올 종료 케이스 범위 (개월)
SR_BACKFILL_MONTHS=3
# 페이지를 얼마나 더 훑고 멈출지 (백필 경계 안전 여유, 개월)
SR_SCAN_MARGIN_MONTHS=3
# 목록 조회 페이지 크기
SR_PAGE_SIZE=100
# 요청 사이 지연 (ms) - 접속 빈도를 낮게 유지
SR_REQUEST_DELAY_MS=800

# 자동 로그인 계정 (선택).
# 설정하면 세션 만료 시 수집기가 스스로 로그인한다.
# 기기 신뢰 쿠키가 살아 있는 동안에는 OTP를 묻지 않는다.
# OTP를 요구받으면 자동 로그인은 중단되고 수동 로그인이 필요하다.
# SR_USERNAME=you@example.com
# SR_PASSWORD=

# 새 답변·수집 실패 알림을 보낼 메신저 웹훅
# Slack / Teams / 카카오워크 / Discord 모두 URL 하나면 됩니다.
SR_WEBHOOK_URL=
# 자동 판별이 안 될 때만 지정 (slack | teams | discord | json)
SR_WEBHOOK_KIND=
# 알림에 넣을 링크 주소.
# 수집 PC 밖에서 링크를 눌러야 하면 localhost 가 아닌 실제 접속 주소로 바꿔야 한다.
SR_APP_URL=http://localhost:3000

# 새 답변 알림에 붙는 요점 요약, 그리고 뷰어의 SR 보고서가 쓴다.
# ⚠ 케이스 본문이 외부로 나가는 통로다. 고객사 인프라 정보가 들어 있으므로
#   무료 티어에 보내면 안 되고, CVE 번역(GEMINI/GROQ)과 키를 섞어 쓰지 않는다.
#   키가 없으면 요약은 원문 발췌로 대신하고 알림은 그대로 나간다.
OPENAI_API_KEY=
SR_OPENAI_MODEL=gpt-4.1

# 팀별 연동 설정(/settings, team_integrations 테이블)에 저장하는 토큰 등 민감값을
# 암호화하는 키(AES-256-GCM). 32바이트를 base64 또는 hex(64자)로 넣는다.
# 없으면 토큰이 있는 저장 요청은 거부된다 — 평문으로 대신 저장하지 않는다.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SR_SECRET_KEY=

# LLM 연결(OpenAI-호환 + Keycloak). 관리자 화면(/settings/llm, DB)에 설정이 없을 때
# 아래 환경변수로 폴백한다. env 경로는 SR_SECRET_KEY 없이도 동작한다(평문 사용).
# LLM_BASE_URL=https://pais.ds.lab/api/v1/compatibility/openai
# LLM_MODEL=google/gemma-4-31b-it
# LLM_AUTH_KIND=keycloak
# LLM_TOKEN_URL=https://pai-keycloak.ds.lab/realms/pais/protocol/openid-connect/token
# LLM_CLIENT_ID=pais-client
# LLM_USERNAME=pais-admin
# LLM_PASSWORD=
# LLM_CHAT_PATH=/v1/chat/completions
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.1
# 사내 자체서명 CA 를 쓰는 LLM/Keycloak 엔드포인트에서 Node 가 인증서를 못 믿어 "fetch failed"
# 가 나면 1 로 켠다. 그러면 LLM·Keycloak 호출에만 TLS 검증을 건너뛴다(브로드컴 수집엔 영향 없음).
# 정석은 NODE_EXTRA_CA_CERTS 로 CA 를 신뢰시키는 것. 이건 내부망 한정 실용 우회다.
# LLM_INSECURE_TLS=
