{
  "name": "broadcom-sr-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "node collector/login.ts",
    "login:cli": "node --conditions=react-server scripts/login-cli.ts",
    "seed:session": "node scripts/seed-session.ts",
    "refresh": "node collector/login.ts --auto && node scripts/seed-session.ts",
    "collect": "node collector/collect.ts",
    "worker": "node collector/worker.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "capture": "node collector/capture.ts",
    "collect:cve": "node collector/collect-cves.ts",
    "translate:cve": "node collector/translate-cves.ts",
    "mcp": "node --conditions=react-server mcp/server.ts",
    "token": "node scripts/team-token.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sparticuz/chromium": "140.0.0",
    "next": "^15.1.0",
    "pg": "^8.23.0",
    "playwright": "1.55.1",
    "playwright-core": "1.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "undici": "^6.28.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
