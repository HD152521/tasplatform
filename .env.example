# 최초 수집 시 가져올 종료 케이스 범위 (개월)
SR_BACKFILL_MONTHS=3
# 페이지를 얼마나 더 훑고 멈출지 (백필 경계 안전 여유, 개월)
SR_SCAN_MARGIN_MONTHS=3
# 목록 조회 페이지 크기
SR_PAGE_SIZE=100
# 요청 사이 지연 (ms) - 접속 빈도를 낮게 유지
SR_REQUEST_DELAY_MS=800

# 자동 로그인 계정 (선택).
# 설정하면 세션 만료 시 수집기가 스스로 로그인한다.
# 기기 신뢰 쿠키가 살아 있는 동안에는 OTP를 묻지 않는다.
# OTP를 요구받으면 자동 로그인은 중단되고 수동 로그인이 필요하다.
#
# ★ 비밀번호를 주기적으로 바꾼다면 여기 대신 **화면**에서 관리하는 쪽이 낫다
#   (/settings/account). 저장된 값이 이 파일을 이기고, 웹·수집기가 같은 값을 본다 —
#   사본 세 군데(작업 PC·VM·드롭릿)를 매번 고치고 재배포할 필요가 없다.
#   여기 값은 "아직 한 번도 저장하지 않았을 때의 폴백" 으로 남는다.
#   화면에서 저장하려면 아래 SR_SECRET_KEY 가 있어야 한다(암호화 키).
# SR_USERNAME=you@example.com
# SR_PASSWORD=

# 자동 로그인 잠금 방지 (선택, 기본값으로 충분하다).
# 연속 실패가 이 횟수에 닿으면 자동 시도를 멈춘다. **시간이 지나도 저절로 풀리지 않는다** —
# 설정 화면에서 새 비밀번호를 저장하거나 직접 로그인해야 다시 시작한다.
# 공용 계정이 잠기는 것을 막는 장치다 — 늘리기 전에 IdP 의 잠금 정책을 확인할 것.
# SR_LOGIN_FAIL_LIMIT=2

# 새 답변·수집 실패 알림을 보낼 메신저 웹훅
# Slack / Teams / 카카오워크 / Discord 모두 URL 하나면 됩니다.
SR_WEBHOOK_URL=
# 자동 판별이 안 될 때만 지정 (slack | teams | discord | json)
SR_WEBHOOK_KIND=
# 알림에 넣을 링크 주소.
# 수집 PC 밖에서 링크를 눌러야 하면 localhost 가 아닌 실제 접속 주소로 바꿔야 한다.
SR_APP_URL=http://localhost:3000

# 새 답변 알림에 붙는 요점 요약, 그리고 뷰어의 SR 보고서가 쓴다.
# ⚠ 케이스 본문이 외부로 나가는 통로다. 고객사 인프라 정보가 들어 있으므로
#   무료 티어에 보내면 안 되고, CVE 번역(GEMINI/GROQ)과 키를 섞어 쓰지 않는다.
#   키가 없으면 요약은 원문 발췌로 대신하고 알림은 그대로 나간다.
OPENAI_API_KEY=
SR_OPENAI_MODEL=gpt-4.1

# 팀별 연동 설정(/settings, team_integrations 테이블)에 저장하는 토큰 등 민감값을
# 암호화하는 키(AES-256-GCM). 32바이트를 base64 또는 hex(64자)로 넣는다.
# 없으면 토큰이 있는 저장 요청은 거부된다 — 평문으로 대신 저장하지 않는다.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SR_SECRET_KEY=

# LLM 연결(OpenAI-호환 + Keycloak). 관리자 화면(/settings/llm, DB)에 설정이 없을 때
# 아래 환경변수로 폴백한다. env 경로는 SR_SECRET_KEY 없이도 동작한다(평문 사용).
# LLM_BASE_URL=https://pais.ds.lab/api/v1/compatibility/openai
# LLM_MODEL=google/gemma-4-31b-it
# LLM_AUTH_KIND=keycloak
# LLM_TOKEN_URL=https://pai-keycloak.ds.lab/realms/pais/protocol/openid-connect/token
# LLM_CLIENT_ID=pais-client
# LLM_USERNAME=pais-admin
# LLM_PASSWORD=
# LLM_CHAT_PATH=/v1/chat/completions
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.1
# 사내 자체서명 CA 를 쓰는 LLM/Keycloak 엔드포인트에서 Node 가 인증서를 못 믿어 "fetch failed"
# 가 나면 1 로 켠다. 그러면 LLM·Keycloak 호출에만 TLS 검증을 건너뛴다(브로드컴 수집엔 영향 없음).
# 정석은 NODE_EXTRA_CA_CERTS 로 CA 를 신뢰시키는 것. 이건 내부망 한정 실용 우회다.
# LLM_INSECURE_TLS=

# ── SR → Jira 티켓 (기본값: 꺼짐) ───────────────────────────────────────────
# SR 을 등록하면 Jira 티켓을 하나 끊는다. **외부에 글을 남기는 기능이라 꺼진 채로
# 배포된다** — 아래 JIRA_AUTO_CREATE=1 일 때만 동작한다(lib/jiraWrite.ts).
# 읽기용 ATLASSIAN_BASE / ATLASSIAN_EMAIL / ATLASSIAN_TOKEN 을 그대로 쓴다.
# JIRA_AUTO_CREATE=1
#
# 티켓을 만들 프로젝트. 비우면 JIRA_PROJECT 로 떨어진다. 변수를 따로 둔 이유는
# JIRA_PROJECT 를 월간 보고서의 작업 조회가 이미 쓰고 있어서다 — 한 값을 두 용도로
# 쓰다가 한쪽을 바꾸면 다른 쪽이 조용히 따라간다.
# JIRA_SR_PROJECT=ABC
#
# 상위 항목(에픽). 최근 SR 티켓들이 이 에픽에 직접 달려 있다. 비우면 상위 항목 없이
# 만든다(그것도 거부되면 티켓은 그대로 만들어진다 — lib/jiraWrite.ts 의 재시도).
# (실제 값은 .env 에만 둔다 — 이 저장소는 공개다)
# JIRA_SR_EPIC=ABC-1
#
# Team 필드(customfield_10001) 값. 비우면 넣지 않는다.
# JIRA_SR_TEAM_ID=
#
# 이슈 타입. 비우면 '작업'. 하위작업 타입(SR오픈 등)을 쓰려면 상위 항목이 필수다.
# JIRA_SR_ISSUETYPE=작업

# ── 앱 로그인(사람) ─────────────────────────────────────────────────
# 이 도구를 쓰는 **사람**의 로그인. 브로드컴 포털 계정과 다른 것이다.
# 비밀번호는 scrypt 해시로만 저장하고, 세션 토큰은 해시만 DB 에 둔다 — 설정할 환경변수가 없다.
#
# 처음 뜬 상태에서는 아무도 가입돼 있지 않다. /signup 에 **처음** 들어온 사람이
# 초대 코드 없이 기본 팀의 관리자(owner)가 되고, 그 뒤부터는 /team 화면의 초대 코드가
# 있어야 가입된다.
#
# 세션 수명(일). 기본 30일. 사내에서 매일 쓰는 화면이라 길게 둔다.
# SR_APP_SESSION_DAYS=30

# ── 캘린더 → Jira 상태 전이 이름 ────────────────────────────────────
# 일정 상태를 바꾸면 Jira 쪽도 상태 전이를 한다. 전이 id 는 프로젝트의 워크플로마다
# 달라서 박아 둘 수 없다 — 그래서 **이름으로** 고른다(가능한 전이를 매번 조회해 맞춘다).
# 아래는 기본 후보에 **덧붙이는** 값이다(쉼표로 여러 개, 앞에 온 것이 우선).
# 후보 중 하나도 워크플로에 없으면 **전이를 건너뛰고** 그 사실을 일정에 적는다 —
# 추측해서 엉뚱한 상태로 밀지 않는다.
#
# 기본 후보
#   진행: 진행 중, 진행중, In Progress, Start Progress, 작업 시작
#   완료: 완료, Done, Resolve Issue, 해결, Resolved, Close Issue
#   취소: 취소, Cancel, Canceled, Cancelled, Won't Do
# JIRA_TR_DOING=
# JIRA_TR_DONE=
# JIRA_TR_CANCELED=
#
# ⚠ 일정을 삭제하면 연결된 **Jira 이슈도 삭제된다**(되돌릴 수 없다). 권한이 없으면
#   지우지 않고 "앱에서 삭제됨" 코멘트를 남기고, 화면이 그 사실을 알려 준다.

# ── 캘린더 일정 → Jira 상위 에픽(법인별) ────────────────────────────
# 이 팀의 Jira 는 **법인을 상위 에픽으로** 가른다(실측: NH은행 운영지원 / NH중앙회
# 운영지원 / NH본사 지원). 캘린더 한 줄 입력에서 #은 / #중 / #본 을 적으면 그 법인의
# 에픽에 달린다. 설정이 없으면 JIRA_SR_EPIC 으로 떨어지고, 화면이 "기본 에픽에 달았다"
# 고 알려 준다 — 조용히 다른 법인으로 세어지는 것을 막기 위해서다.
# (실제 값은 .env 에만 둔다 — 이 저장소는 공개다)
# JIRA_EPIC_BANK=ABC-1
# JIRA_EPIC_CENTRAL=ABC-2
# JIRA_EPIC_HQ=ABC-3
#
# 제목·라벨 규칙은 설정이 아니라 코드에 있다(lib/jiraHouseStyle.ts). 집계로 뽑은
# 규칙이라 바꿀 일이 생기면 그 파일의 머리말부터 읽을 것.
#   제목 앞 대괄호 = 전산망(운영·개발·DR·AWS·검증·본사·안성), 여럿이면 '/' 로 이음
#   라벨           = 업무 성격(TAS_작업지원 기본 / TAS_장애대응 / TAS_내부업무)

# Jira → 캘린더 가져오기(백필)의 시작 날짜.
# 이 날 이후에 **시작한** Jira 작업(Start date, 없으면 생성일)을 캘린더로 가져온다.
# 비우면 이번 달 1일. 더 거슬러 올라가면 몇 년치가 한꺼번에 들어와 달력이 과거로
# 가득 차고, 그 대부분은 이미 끝난 일이라 볼 이유가 없다.
# 에픽·SR(SR오픈·TAS_SR)·캘린더가 만든 이슈는 가져오지 않는다.
# JIRA_IMPORT_FROM=2026-11-01

# ── 메모장 → 노션 ──────────────────────────────────────────────────────────
# 여기에 넣을 게 없다. 노션 연결은 **사람별**이고 화면에서 넣는다(/me 「노션 연결」).
# 토큰은 그 사람의 노션에 쓰는 열쇠라, 팀 하나로 두면 한 사람의 노션이 팀 전체에 열린다.
#
# 단, 토큰을 저장하려면 위의 SR_SECRET_KEY 가 있어야 한다(AES-256-GCM). 키가 없으면
# 화면이 그렇게 말하고 저장을 거부한다 — 평문 폴백은 없다.
#
# ⚠ 이 서버에서 api.notion.com 으로 **나가는 길**이 필요하다. 사내망에서 막혀 있으면
#   올리기가 "노션에 닿지 못했습니다" 로 끝난다(그 메시지가 그렇게 말해 준다).
